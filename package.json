{
  "name": "lurkbox-monorepo",
  "version": "0.1.0",
  "description": "Lurkbox: a couch/controller client for Twitch. Monorepo for the shared core and the platform apps.",
  "private": true,
  "license": "GPL-3.0-or-later",
  "author": "aronwk-aaron",
  "workspaces": [
    "packages/core",
    "apps/desktop",
    "apps/android"
  ],
  "scripts": {
    "start": "npm run start -w apps/desktop --",
    "dist": "npm run dist -w apps/desktop --",
    "test": "npm test --workspaces --if-present",
    "test:smoke": "npm run test:smoke -w apps/desktop --",
    "test:play": "npm run test:play -w apps/desktop --",
    "test:direct": "npm run test:direct -w apps/desktop --",
    "test:vod": "npm run test:vod -w apps/desktop --",
    "test:rewind": "npm run test:rewind -w apps/desktop --",
    "test:points": "npm run test:points -w apps/desktop --",
    "test:drops": "npm run test:drops -w apps/desktop --",
    "test:follow": "npm run test:follow -w apps/desktop --",
    "test:points-cookies": "npm run test:points-cookies -w apps/desktop --",
    "test:chat": "npm run test:chat -w apps/desktop --",
    "test:chat-send": "npm run test:chat-send -w apps/desktop --",
    "test:channel": "npm run test:channel -w apps/desktop --",
    "test:continue": "npm run test:continue -w apps/desktop --",
    "test:multiview": "npm run test:multiview -w apps/desktop --",
    "test:updates": "npm run test:updates -w apps/desktop --",
    "test:predictions": "npm run test:predictions -w apps/desktop --",
    "screenshots": "npm run screenshots -w apps/desktop --",
    "android:sync": "npm run sync -w apps/android --",
    "android:build": "npm run build -w apps/android --",
    "android:release": "npm run release -w apps/android --"
  }
}
